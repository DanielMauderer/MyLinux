/* Rofi colors - Generated by matugen */
* {
    /* Base colors */
    bg:                     #1a110f;
    bg-alt:                 #271d1b;
    bg-selected:            #322825;
    
    /* Foreground colors */
    fg:                     #f1dfda;
    fg-alt:                 #d8c2bc;
    fg-disabled:            #a08c87;
    
    /* Accent colors */
    accent:                 #ffb5a0;
    accent-alt:             #e7bdb2;
    urgent:                 #ffb4ab;
    
    /* Surface variants */
    border:                 #53433f;
    separator:              #3d3230;
    
    /* Transparency variants */
    bg-trans:               #1a110fe6;
    accent-trans:           #ffb5a033;
}
