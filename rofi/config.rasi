configuration {
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Windows";
    display-filebrowser: " Files";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
    font: "JetBrainsMono Nerd Font 11";
    icon-theme: "Papirus-Dark";
    terminal: "kitty";
}

@theme "theme"
