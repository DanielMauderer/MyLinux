/* Rofi colors - Generated by matugen */
* {
    /* Base colors */
    bg:                     {{ colors.surface.default.hex }};
    bg-alt:                 {{ colors.surface_container.default.hex }};
    bg-selected:            {{ colors.surface_container_high.default.hex }};
    
    /* Foreground colors */
    fg:                     {{ colors.on_surface.default.hex }};
    fg-alt:                 {{ colors.on_surface_variant.default.hex }};
    fg-disabled:            {{ colors.outline.default.hex }};
    
    /* Accent colors */
    accent:                 {{ colors.primary.default.hex }};
    accent-alt:             {{ colors.secondary.default.hex }};
    urgent:                 {{ colors.error.default.hex }};
    
    /* Surface variants */
    border:                 {{ colors.outline_variant.default.hex }};
    separator:              {{ colors.surface_container_highest.default.hex }};
    
    /* Transparency variants */
    bg-trans:               {{ colors.surface.default.hex }}e6;
    accent-trans:           {{ colors.primary.default.hex }}33;
}
